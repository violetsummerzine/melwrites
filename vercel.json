{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/resume.js": {
      "includeFiles": "private/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(img|media)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work/ai-human-data",
      "destination": "/work/mercor-scale",
      "permanent": true
    },
    {
      "source": "/work/ai-human-data.html",
      "destination": "/work/mercor-scale",
      "permanent": true
    },
    {
      "source": "/work/ai-reading-companion",
      "destination": "/work/joy-ai-agent",
      "permanent": true
    },
    {
      "source": "/work/ai-reading-companion.html",
      "destination": "/work/joy-ai-agent",
      "permanent": true
    }
  ]
}
